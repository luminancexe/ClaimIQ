# ============================================================================
# ClaimIQ Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local settings.
# DO NOT commit .env or real credentials to source control.
# ============================================================================

# ----------------------------------------------------------------------------
# Database Connection (MySQL 8.x / InnoDB)
# ----------------------------------------------------------------------------
CLAIMIQ_DB_HOST=127.0.0.1
CLAIMIQ_DB_PORT=3306
CLAIMIQ_DB_NAME=claimiq
CLAIMIQ_DB_USER=claimiq_user
CLAIMIQ_DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# Alternative fallback variables (supported for legacy/CI compatibility)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=claimiq
# MYSQL_USER=claimiq_user
# MYSQL_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# ----------------------------------------------------------------------------
# Backend & REST API Configuration (Phase 7)
# ----------------------------------------------------------------------------
CLAIMIQ_API_HOST=0.0.0.0
CLAIMIQ_API_PORT=8000
CLAIMIQ_CORS_ORIGINS=*

# JWT Signing Secret (IMPORTANT: Generate a cryptographically secure random string in production)
# e.g., python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAIMIQ_JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
CLAIMIQ_JWT_EXPIRATION_MINUTES=60
CLAIMIQ_JWT_REFRESH_EXPIRATION_MINUTES=1440
